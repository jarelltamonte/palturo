# Local configuration for PalTuro.
# Copy this file to .env and fill in your own project values. .env is gitignored.
#
# .env is NOT bundled into the app. Pass it at build/run time instead:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#   flutter build web --dart-define-from-file=.env
#
# The publishable (anon) key is safe to ship only while RLS is enforced on your
# tables. Never put a service-role key, a Supabase personal access token, or any
# other secret in this file: --dart-define-from-file compiles every value into
# the client. Keep CLI tokens in .env.cli instead.

# Example values (replace the empty values below):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public origin used in Supabase auth email links.
# Defaults to https://palturo.app when empty.
APP_PUBLIC_URL=
