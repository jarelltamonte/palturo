{
  "name": "palturo-auth",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "../build/web-merged",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "palturo.app", "custom_domain": true },
    { "pattern": "www.palturo.app", "custom_domain": true }
  ]
}
